{
  "name": "@runyard-ai/runyard-sdk",
  "version": "0.55.0",
  "description": "The TypeScript client of runyard-agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runyard-ai/runyard-sdk.git",
    "directory": "typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ry": {
      "types": "./dist/ry.d.ts",
      "default": "./dist/ry.js"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "default": "./dist/relay.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test build/test/errors.test.js build/test/streams.test.js build/test/ry.test.js build/test/relay.test.js",
    "conformance": "tsc -p tsconfig.test.json && node --test build/test/conformance.test.js build/test/ry.conformance.test.js build/test/relay.conformance.test.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
